{
  "name": "@averri/seed-app",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Averri reference application: a multi-tenant SaaS backend (organizations, members, invitations, RBAC, projects, tasks, API keys, Stripe-style billing webhook, audit log) in Hono + Prisma + Zod",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "start": "tsx --conditions=development src/server.ts",
    "test": "vitest run",
    "db:push": "tsx --conditions=development scripts/db-push.ts",
    "db:seed": "tsx --conditions=development scripts/db-seed.ts",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migration": "tsx --conditions=development scripts/db-migration.ts",
    "averri": "tsx --conditions=development ../../packages/cli/src/bin.ts",
    "test:averri": "vitest run tests/averri"
  },
  "dependencies": {
    "@averri/core": "0.1.0-alpha.0",
    "@hono/node-server": "^2.1.5",
    "@prisma/client": "^6.19.3",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@averri/cli": "0.1.0-alpha.0",
    "@averri/contracts": "0.1.0-alpha.0",
    "fast-check": "^4.10.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "vitest": "^2.1.9"
  }
}
