# Copy to .env (gitignored). The scripts default DATABASE_URL to prisma/dev.db when unset.
DATABASE_URL="file:./dev.db"
PORT=3000
# Stripe webhook signing secret (any string works locally; tests set their own).
STRIPE_WEBHOOK_SECRET="whsec_dev_secret"
# Leave unset to use the in-memory fake Stripe client.
# STRIPE_SECRET_KEY="sk_test_..."
