    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mrleebo/prisma-ast": "^0.15.0",
    "commander": "^14.0.3",
    "express": "^5.3.0",
    "fast-check": "^4.10.2",
    "fast-glob": "^3.3.3",
    "hono": "^4.13.13",
    "picocolors": "^1.1.1",
