{
  "name": "@averri/compiler",
  "version": "0.1.0-alpha.0",
  "description": "Averri compiler: static lowering of declarations, verifiers, diagnostics, graph cache, impact, check, explain, spec cards and OpenAPI",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "averri",
    "typescript",
    "contracts",
    "agents",
    "mcp",
    "prisma",
    "hono",
    "ai",
    "compiler"
  ],
  "homepage": "https://github.com/abhijeethrkgadwal/averri/tree/main/packages/compiler#readme",
  "bugs": {
    "url": "https://github.com/abhijeethrkgadwal/averri/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhijeethrkgadwal/averri.git",
    "directory": "packages/compiler"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --dir test",
    "prepack": "node ../../scripts/pack-hooks.mjs prepack",
    "postpack": "node ../../scripts/pack-hooks.mjs postpack"
  },
  "dependencies": {
    "@averri/extract": "0.1.0-alpha.0",
    "@averri/ir": "0.1.0-alpha.0",
    "@averri/testgen": "0.1.0-alpha.0",
    "fast-glob": "^3.3.3",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@averri/core": "0.1.0-alpha.0",
    "fast-check": "^4.10.2"
  }
}
