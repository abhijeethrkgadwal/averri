{
  "name": "@averri/contracts",
  "version": "0.1.0-alpha.0",
  "description": "Averri runtime: tier-1 expression evaluator, db.* predicate compiler, guard runner, declared-mode pipeline (handle/toHono/toExpress), observe-mode Vitest wrapper and JSONL trace recorder",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "averri",
    "typescript",
    "contracts",
    "agents",
    "mcp",
    "prisma",
    "hono",
    "ai"
  ],
  "homepage": "https://github.com/abhijeethrkgadwal/averri/tree/main/packages/contracts#readme",
  "bugs": {
    "url": "https://github.com/abhijeethrkgadwal/averri/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhijeethrkgadwal/averri.git",
    "directory": "packages/contracts"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --dir test",
    "prepack": "node ../../scripts/pack-hooks.mjs prepack",
    "postpack": "node ../../scripts/pack-hooks.mjs postpack"
  },
  "dependencies": {
    "@averri/core": "0.1.0-alpha.0",
    "@averri/ir": "0.1.0-alpha.0"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "hono": "^4.0.0",
    "vitest": "^2.0.0",
    "fast-check": "^4.0.0",
    "@prisma/client": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "fast-check": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    }
  }
}
