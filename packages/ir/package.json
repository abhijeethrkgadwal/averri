{
  "name": "@averri/ir",
  "version": "0.1.0-alpha.0",
  "description": "Averri Semantic IR: types, contract AST, diagnostic registry, zod schemas and pure helpers (ids, tier, sort, validate, diff, dependsOn, health)",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "averri",
    "typescript",
    "contracts",
    "agents",
    "mcp",
    "prisma",
    "hono",
    "ai",
    "ir"
  ],
  "homepage": "https://github.com/abhijeethrkgadwal/averri/tree/main/packages/ir#readme",
  "bugs": {
    "url": "https://github.com/abhijeethrkgadwal/averri/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhijeethrkgadwal/averri.git",
    "directory": "packages/ir"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --dir test",
    "prepack": "node ../../scripts/pack-hooks.mjs prepack",
    "postpack": "node ../../scripts/pack-hooks.mjs postpack"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
